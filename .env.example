# Sanity CMS — create a free project at https://www.sanity.io/manage
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_TOKEN=

# Resend — HTTP email API for the Contact & Booking forms (Cloudflare Workers
# can't send SMTP directly). Free tier at https://resend.com. Without an API
# key, submissions still succeed and are just logged instead of emailed.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
CONTACT_TO_EMAIL=tangtriduc@triduccar.media

# Only used when running as a standalone Node.js process (e.g. Namecheap
# cPanel "Setup Node.js App" via server.js) — not needed for Cloudflare Pages.
PORT=3000
